{
  "name": "3827992canadainc-com-site",
  "version": "0.1.0",
  "description": "Source for 3827992canadainc.com, the corporate site of 3827992 Canada Inc.",
  "repository": "github:3827992canadainc/3827992canadainc-com.github.io",
  "homepage": "https://3827992canadainc.com",
  "author": "3827992 Canada Inc.",
  "license": "Apache-2.0",
  "bugs": "https://github.com/3827992canadainc/3827992canadainc-com.github.io/issues",
  "scripts": {
    "_hugo": "hugo --cleanDestinationDir",
    "_hugo-dev": "npm run _hugo -- -e dev -DFE",
    "_serve": "npm run _hugo-dev -- --minify serve --renderToMemory",
    "serve": "npm run _serve",
    "build:production": "npm run _hugo -- --minify",
    "postbuild:production": "npm run _check:links",
    "_check:links": "./scripts/check-links.sh",
    "check:links": "npm run _check:links",
    "check:links:external": "./scripts/check-links.sh --external",
    "clean": "rm -Rf public/* resources",
    "postinstall": "node scripts/ensure-dart-sass.mjs",
    "update:hugo": "npm install --save-dev --save-exact hugo-extended@latest",
    "update:pkgs": "npx npm-check-updates -u"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "hugo-extended": "0.169.0",
    "postcss": "^8.5.3",
    "postcss-cli": "^12.0.0",
    "rtlcss": "^4.3.0",
    "sass-embedded": "1.105.0"
  },
  "optionalDependencies": {
    "npm-check-updates": "^23.1.1"
  },
  "private": true,
  "prettier": {
    "proseWrap": "always",
    "singleQuote": true
  },
  "workspaces": [
    "packages/hugoautogen"
  ]
}
